{
  "name": "@acme/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "corepack pnpm --filter @acme/contracts build",
    "build": "tsc --project tsconfig.json && vite build",
    "predev": "corepack pnpm --filter @acme/contracts build",
    "dev": "vite",
    "preview": "vite preview",
    "pretest": "corepack pnpm --filter @acme/contracts build",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@acme/contracts": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.13.0",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "vite": "^8.3.0"
  }
}

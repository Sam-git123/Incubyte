{
  "name": "acme-salary-management",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present run build",
    "db:generate": "corepack pnpm --filter @acme/api db:generate",
    "db:migrate": "corepack pnpm --filter @acme/api db:migrate",
    "db:migrate:deploy": "corepack pnpm --filter @acme/api db:migrate:deploy",
    "db:reset": "corepack pnpm --filter @acme/api db:reset",
    "db:seed": "corepack pnpm --filter @acme/api db:seed",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"corepack pnpm --filter @acme/api dev\" \"corepack pnpm --filter @acme/web dev\"",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "corepack pnpm --recursive --if-present run test",
    "typecheck": "corepack pnpm --recursive --if-present run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
